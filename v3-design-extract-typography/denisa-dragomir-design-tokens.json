{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "coal": { "$value": "#0D0D0B", "$type": "color" },
    "basalt": { "$value": "#1F211A", "$type": "color" },
    "forest-night": { "$value": "#2E3427", "$type": "color" },
    "stone": { "$value": "#D9E2D5", "$type": "color" },
    "sand": { "$value": "#D5C7B5", "$type": "color" },
    "clay": { "$value": "#A08B45", "$type": "color" },
    "gold": { "$value": "#B87942", "$type": "color", "$description": "Hero ornaments, gold CTA variant" },
    "burnt-orange": { "$value": "#D86A2B", "$type": "color" },
    "rust": { "$value": "#9A4600", "$type": "color", "$description": "Deep accent, hover states, emphasis on light backgrounds" },
    "alpine-moss": { "$value": "#6B705F", "$type": "color" },
    "white": { "$value": "#FAF9F6", "$type": "color", "$description": "Warm-tinted surface, polaroid frames" },
    "paper": { "$value": "#EDE7DC", "$type": "color", "$description": "Page background, subtle fills" },
    "background": {
      "dark": { "$value": "{color.coal}", "$type": "color" },
      "dark-elevated": { "$value": "{color.basalt}", "$type": "color" },
      "light": { "$value": "{color.stone}", "$type": "color" },
      "paper": { "$value": "{color.paper}", "$type": "color" }
    },
    "foreground": {
      "primary": { "$value": "{color.coal}", "$type": "color" },
      "on-dark": { "$value": "{color.white}", "$type": "color" },
      "muted": { "$value": "{color.alpine-moss}", "$type": "color" },
      "accent": { "$value": "{color.burnt-orange}", "$type": "color" }
    }
  },
  "font": {
    "family": {
      "display": { "$value": "Cormorant Garamond, Georgia, serif", "$type": "fontFamily" },
      "body": { "$value": "Inter, system-ui, sans-serif", "$type": "fontFamily" },
      "handwritten": { "$value": "Caveat, cursive", "$type": "fontFamily" }
    },
    "weight": {
      "light": { "$value": "300", "$type": "fontWeight" },
      "regular": { "$value": "400", "$type": "fontWeight" },
      "medium": { "$value": "500", "$type": "fontWeight" },
      "semibold": { "$value": "600", "$type": "fontWeight" }
    },
    "letterSpacing": {
      "tight": { "$value": "-0.02em", "$type": "dimension" },
      "wide": { "$value": "0.04em", "$type": "dimension" },
      "nav": { "$value": "0.08em", "$type": "dimension" },
      "overline": { "$value": "0.12em", "$type": "dimension" }
    },
    "semantic": {
      "$description": "Mobile base — responsive steps in denisa-dragomir-variables.css",
      "display-hero": {
        "size": { "$value": "2.5rem", "$type": "dimension" },
        "lineHeight": { "$value": "1.08", "$type": "number" },
        "weight": { "$value": "{font.weight.regular}", "$type": "fontWeight" },
        "family": { "$value": "{font.family.display}", "$type": "fontFamily" }
      },
      "display-xl": {
        "size": { "$value": "2rem", "$type": "dimension" },
        "lineHeight": { "$value": "1.1", "$type": "number" },
        "family": { "$value": "{font.family.display}", "$type": "fontFamily" }
      },
      "body": {
        "size": { "$value": "1rem", "$type": "dimension" },
        "lineHeight": { "$value": "1.65", "$type": "number" },
        "family": { "$value": "{font.family.body}", "$type": "fontFamily" }
      },
      "body-sm": {
        "size": { "$value": "0.875rem", "$type": "dimension" },
        "lineHeight": { "$value": "1.5", "$type": "number" },
        "family": { "$value": "{font.family.body}", "$type": "fontFamily" }
      },
      "label": {
        "size": { "$value": "0.75rem", "$type": "dimension" },
        "lineHeight": { "$value": "1.4", "$type": "number" },
        "weight": { "$value": "{font.weight.semibold}", "$type": "fontWeight" },
        "letterSpacing": { "$value": "{font.letterSpacing.wide}", "$type": "dimension" }
      },
      "nav": {
        "size": { "$value": "0.75rem", "$type": "dimension" },
        "lineHeight": { "$value": "1.2", "$type": "number" },
        "weight": { "$value": "{font.weight.medium}", "$type": "fontWeight" },
        "letterSpacing": { "$value": "{font.letterSpacing.nav}", "$type": "dimension" }
      },
      "button": {
        "size": { "$value": "0.875rem", "$type": "dimension" },
        "lineHeight": { "$value": "1.2", "$type": "number" },
        "weight": { "$value": "{font.weight.semibold}", "$type": "fontWeight" }
      },
      "handwritten": {
        "size": { "$value": "1.375rem", "$type": "dimension" },
        "lineHeight": { "$value": "1.3", "$type": "number" },
        "family": { "$value": "{font.family.handwritten}", "$type": "fontFamily" }
      },
      "polaroid-caption": {
        "size": { "$value": "1.15rem", "$type": "dimension" },
        "lineHeight": { "$value": "1.45", "$type": "number" },
        "family": { "$value": "{font.family.display}", "$type": "fontFamily" }
      },
      "form-input": {
        "size": { "$value": "1rem", "$type": "dimension" },
        "lineHeight": { "$value": "1.5", "$type": "number" },
        "family": { "$value": "{font.family.body}", "$type": "fontFamily" }
      }
    }
  },
  "spacing": {
    "1": { "$value": "0.25rem", "$type": "dimension" },
    "2": { "$value": "0.5rem", "$type": "dimension" },
    "3": { "$value": "0.75rem", "$type": "dimension" },
    "4": { "$value": "1rem", "$type": "dimension" },
    "6": { "$value": "1.5rem", "$type": "dimension" },
    "8": { "$value": "2rem", "$type": "dimension" },
    "12": { "$value": "3rem", "$type": "dimension" },
    "16": { "$value": "4rem", "$type": "dimension" },
    "24": { "$value": "6rem", "$type": "dimension" },
    "32": { "$value": "8rem", "$type": "dimension" },
    "section": { "$value": "5rem", "$type": "dimension" },
    "section-lg": { "$value": "7.5rem", "$type": "dimension" }
  },
  "radius": {
    "none": { "$value": "0", "$type": "dimension" },
    "sm": { "$value": "4px", "$type": "dimension" },
    "md": { "$value": "8px", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
  "shadow": {
    "polaroid": {
      "$value": "0 8px 32px oklch(0.13 0.012 85 / 0.12)",
      "$type": "shadow"
    },
    "card": {
      "$value": "0 8px 32px rgba(13, 13, 11, 0.25)",
      "$type": "shadow"
    }
  },
  "breakpoint": {
    "sm": { "$value": "640px", "$type": "dimension" },
    "md": { "$value": "768px", "$type": "dimension" },
    "lg": { "$value": "1024px", "$type": "dimension" },
    "xl": { "$value": "1280px", "$type": "dimension" },
    "2xl": { "$value": "1440px", "$type": "dimension" }
  },
  "animation": {
    "duration": {
      "fast": { "$value": "200ms", "$type": "duration" },
      "normal": { "$value": "300ms", "$type": "duration" },
      "slow": { "$value": "800ms", "$type": "duration" }
    },
    "easing": {
      "default": { "$value": "cubic-bezier(0.25, 0.1, 0.25, 1)", "$type": "cubicBezier" }
    }
  }
}
